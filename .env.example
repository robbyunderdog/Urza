DISCORD_TOKEN=your-bot-token-here

# Postgres connection string from Neon or Supabase. Either works unchanged —
# this bot only needs plain Postgres. If you're on a pgbouncer-based pooled
# connection (Neon's pooled endpoint, or Supabase's port-6543 pooler),
# prepared-statement caching is already disabled in utils/database.py so it
# works with either the pooled or direct connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: set to a guild ID during development for instant slash-command
# sync in that one server. Leave blank to sync globally (takes up to an
# hour to propagate, but works in every server the bot is in).
DEV_GUILD_ID=

# Optional: override the free-pack cooldown (default 14400s/4h). Handy to
# set to 0 while testing.
PACK_COOLDOWN_SECONDS=

# Optional: directory to cache downloaded card images in, so repeat cards
# skip the Scryfall download. Leave blank to disable. docker-compose.yml
# sets this itself (to a mounted volume), so this is only for running
# outside Docker.
IMAGE_CACHE_DIR=

# Optional: with IMAGE_CACHE_DIR set, the bot downloads every missing card
# image on startup and then every this many hours (default 168 = weekly).
IMAGE_CACHE_REFRESH_HOURS=

# Optional: Postgres connection pool size (defaults: min 2, max 20). Raise
# max if you deploy to many concurrent guilds and see pool-exhaustion
# warnings in the logs.
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=
